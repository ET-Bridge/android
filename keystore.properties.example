# Copy to keystore.properties (git-ignored) to sign release builds with your own key.
# Generate a key with:
#   keytool -genkeypair -keystore ~/.config/etbridge/etbridge-release.jks -storetype PKCS12 \
#     -alias etbridge -keyalg RSA -keysize 4096 -validity 10000
storeFile=/absolute/path/to/etbridge-release.jks
storePassword=change-me
keyAlias=etbridge
keyPassword=change-me
